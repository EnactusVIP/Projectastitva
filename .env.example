# ==============================================================================
# Project Astitva — Environment Variables Reference
# NOTE: Never commit secret keys or production values to version control.
# ==============================================================================

# Google Gemini API Configuration (Server-Side Only for Saathi AI Companion)
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: AI Provider Selection ('gemini' is default)
AI_PROVIDER=gemini

# Optional: Future xAI Grok (Server-Side Only)
# XAI_API_KEY=
# XAI_MODEL=grok-2

# Google Sheets Community Integration (Server-Side Only)
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
